---
interface Props {
  title: string;
  namespace?: string;
  category: 'WPF XAML' | 'Transform 2D' | 'Animation' | 'Architecture' | 'Quality' | 'Geometry';
  url: string;
  description: string;
}

const { title, namespace, category, url, description } = Astro.props;

// Category badge color mapping
const categoryColors: Record<string, string> = {
  'WPF XAML': 'bg-cyan-950/40 text-cyan-400 border-cyan-500/30',
  'Transform 2D': 'bg-amber-950/40 text-amber-400 border-amber-500/30',
  'Animation': 'bg-emerald-950/40 text-emerald-400 border-emerald-500/30',
  'Architecture': 'bg-blue-950/40 text-blue-400 border-blue-500/30',
  'Quality': 'bg-purple-950/40 text-purple-400 border-purple-500/30',
  'Geometry': 'bg-rose-950/40 text-rose-400 border-rose-500/30',
};

const badgeClass = categoryColors[category] || 'bg-slate-800 text-slate-300 border-slate-700';
---

<div class="my-4 p-4 rounded-lg bg-[#0f172a] border border-[#1e293b] hover:border-cyan-500/50 transition-colors shadow-md relative group">
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <!-- Microsoft Learn SVG Logo -->
      <div class="w-7 h-7 rounded bg-[#162032] border border-[#334155] flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
      </div>

      <div>
        <div class="m-0 text-sm font-semibold text-slate-100 font-mono flex items-center gap-2">
          {title}
        </div>
        {namespace && (
          <span class="text-xs font-mono text-slate-400 block mt-0.5">
            {namespace}
          </span>
        )}
      </div>
    </div>

    <!-- Category Badge -->
    <span class={`text-[11px] font-mono px-2 py-0.5 rounded border ${badgeClass} shrink-0`}>
      {category}
    </span>
  </div>

  <p class="mt-2.5 mb-3 text-sm text-slate-300 leading-relaxed">
    {description}
  </p>

  <div class="pt-2 border-t border-[#1e293b] flex items-center justify-between">
    <span class="text-[11px] font-mono text-slate-400 flex items-center gap-1">
      <svg class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      Documentação Oficial Microsoft
    </span>

    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors font-mono"
    >
      <span>Consultar API</span>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  </div>
</div>
