# ------------------------------------------------------------------------------
# 2. Visual Studio e Ambientes de Desenvolvimento
# ------------------------------------------------------------------------------
.vs/
*.DotSettings.user
_ReSharper*/

# VS Code (Permite versionar settings.json, tasks.json, launch.json, extensions.json)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log

