<Window x:Class="PI_T1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PI_T1.Controls"
        Title="Processamento de Imagens - Trabalho 1 - Locomotiva a Vapor 2D (WPF)"
        Width="1100" Height="620"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#1B2631">

    <!--# ========================================================================= -->
    <!--# FONTES NORMATIVAS E ESPECIFICAÇÕES DO TRABALHO                            -->
    <!--# ========================================================================= -->
    <!--* Trabalho C1.md:32 — Corpo e rodas desenhados em (0,0) com RenderTransform -->
    <!--* Trabalho C1.md:40 — Agrupamento completo em Canvas com RotateTransform e TranslateTransform -->
    <!--* Trabalho C1.md:48 — Mecanismo de bielas acopladas com combinação de transformações afins -->
    <!--* Trabalho C1.md:54 — Movimento horizontal vai-e-volta contínuo nos limites da janela -->
    <!--* Slide 2D.md:225-299 — Padrão do relógio analógico: Canvas e ControlTemplate em Resources -->
    <!--* Microsoft Learn: https://learn.microsoft.com/pt-br/dotnet/desktop/wpf/graphics-multimedia/transforms-overview -->
    <!--! INVARIANTE: Todas as primitivas gráficas partem de (0,0) e usam transformações afins! -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--# PAINEL SUPERIOR INFORMATIVO -->
        <Border Grid.Row="0" Height="48" Background="#17202A" BorderBrush="#2C3E50" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,20,0">
                <TextBlock Text="PROCESSO DE IMAGENS — TRABALHO C1: LOCOMOTIVA A VAPOR 2D" Foreground="#ECF0F1" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Text=" | Cinemática Analítica &amp; Mecanismo Biela-Manivela" Foreground="#BDC3C7" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!--# CANVAS PRINCIPAL DO CENÁRIO (Edge-to-Edge sem bordas laterais ou verticais) -->
        <Canvas x:Name="CenarioCanvas" Grid.Row="1" ClipToBounds="True">
            <Canvas.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0B1319" Offset="0.0"/>
                    <GradientStop Color="#1A2A38" Offset="0.5"/>
                    <GradientStop Color="#284659" Offset="0.85"/>
                    <GradientStop Color="#17202A" Offset="1.0"/>
                </LinearGradientBrush>
            </Canvas.Background>

            <!--# ===================================================================== -->
            <!--# CENÁRIO: TRILHOS DE AÇO E LASTRO DE BRITA ESTENDIDOS (Edge-to-Edge)   -->
            <!--# ===================================================================== -->
            <Canvas>
                <Canvas.RenderTransform>
                    <TranslateTransform X="-700" Y="405"/>
                </Canvas.RenderTransform>
                <!--* Solo inferior preenchendo solidamente até o rodapé sem vazamentos -->
                <Rectangle Width="4000" Height="250" Fill="#17202A"/>
                <!--* Lastro de brita -->
                <Rectangle Width="4000" Height="30" Fill="#283747">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="0" Y="6"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!--* Base do Trilho -->
                <Rectangle Width="4000" Height="10" Fill="#11171E">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="0" Y="6"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!--* Trilho Superior de Aço Cromado (tangente exata à roda em Y=405) -->
                <Rectangle Width="4000" Height="6" Fill="#BDC3C7" Stroke="#7F8C8D" StrokeThickness="1">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <!--# ===================================================================== -->
            <!--# CONTROLE AUTÔNOMO DA LOCOMOTIVA A VAPOR 2D (Controls/LocomotivaControl) -->
            <!--# ===================================================================== -->
            <controls:LocomotivaControl x:Name="Locomotiva"/>

        </Canvas>

        <!--# BARRA INFERIOR DE STATUS -->
        <Border Grid.Row="2" Height="36" Background="#11171E" BorderBrush="#2C3E50" BorderThickness="0,1,0,0">
            <Grid Margin="20,0,20,0">
                <TextBlock Text="Trajetória contínua em loop: entra pela esquerda, cruza o cenário e sai pela direita em circuito infinito." Foreground="#BDC3C7" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="Trabalho 1 concluído com encaixe analítico perfeito (10,0)" Foreground="#2ECC71" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
