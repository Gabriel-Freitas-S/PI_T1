<Window x:Class="PI_T1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processamento de Imagens - Trabalho 1 - Locomotiva a Vapor 2D (WPF)"
        Width="1100" Height="620"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#1B2631">

    <!-- # ========================================================================= -->
    <!-- # FONTES NORMATIVAS E ESPECIFICAÇÕES DO TRABALHO (Better Comments)          -->
    <!-- # ========================================================================= -->
    <!-- * Trabalho C1.md:32 — Corpo e rodas desenhados em (0,0) com RenderTransform -->
    <!-- * Trabalho C1.md:40 — Agrupamento completo em Canvas com RotateTransform e TranslateTransform -->
    <!-- * Trabalho C1.md:48 — Mecanismo de bielas acopladas com combinação de transformações afins -->
    <!-- * Trabalho C1.md:54 — Movimento horizontal vai-e-volta contínuo nos limites da janela -->
    <!-- * Slide 2D.md:225-299 — Padrão do relógio analógico: Canvas e ControlTemplate em Resources -->
    <!-- * Microsoft Learn: https://learn.microsoft.com/pt-br/dotnet/desktop/wpf/graphics-multimedia/transforms-overview -->
    <!-- ! INVARIANTE: Todas as primitivas gráficas partem de (0,0) e usam transformações afins! -->

    <Grid>
        <!-- # PAINEL SUPERIOR INFORMATIVO -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="50" Background="#17202A" BorderBrush="#2C3E50" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,20,0">
                <TextBlock Text="PROCESSO DE IMAGENS — TRABALHO C1: LOCOMOTIVA A VAPOR 2D" Foreground="#ECF0F1" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Text=" | Mecanismo Biela-Manivela &amp; Cinemática Analítica WPF" Foreground="#BDC3C7" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- # CANVAS PRINCIPAL DO CENÁRIO -->
        <Canvas x:Name="CenarioCanvas" Width="1060" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" ClipToBounds="True">
            <Canvas.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0B1319" Offset="0.0"/>
                    <GradientStop Color="#1A2A38" Offset="0.5"/>
                    <GradientStop Color="#284659" Offset="0.85"/>
                    <GradientStop Color="#17202A" Offset="1.0"/>
                </LinearGradientBrush>
            </Canvas.Background>

            <!-- # ===================================================================== -->
            <!-- # RECURSOS: CONTROLTEMPLATE DA RODA DA LOCOMOTIVA (Slide 2D.md:258)     -->
            <!-- # ===================================================================== -->
            <!-- * Centro analítico do eixo rigorosamente em (40,40), diâmetro 80px      -->
            <!-- * 8 raios em cruz e diagonais convergindo exatamente ao centro (40,40)   -->
            <!-- * Manivela sólida de aço ligando o centro (40,40) ao pino (62,40), r=22px-->
            <!-- ! Contrapeso em meia-lua posicionado a 180° para balanceamento dinâmico -->
            <Canvas.Resources>
                <ControlTemplate x:Key="RodaTemplate" TargetType="{x:Type Control}">
                    <Canvas Width="80" Height="80">
                        <!-- Aro externo de aco forjado -->
                        <Ellipse Width="80" Height="80" Stroke="#17202A" StrokeThickness="5" Fill="#212F3D">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Pneu intermediario metalico -->
                        <Ellipse Width="70" Height="70" Stroke="#7F8C8D" StrokeThickness="2" Fill="#2C3E50">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="5" Y="5"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Contrapeso de balanceamento (lado esquerdo, oposto a manivela) -->
                        <Polygon Points="10,24 38,24 38,56 10,56" Fill="#17202A">
                            <Polygon.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Polygon.RenderTransform>
                        </Polygon>

                        <!-- 8 Raios simetricos convergindo exatamente ao centro (40,40) -->
                        <Line X1="0" Y1="0" X2="0" Y2="64" Stroke="#ECF0F1" StrokeThickness="3">
                            <Line.RenderTransform>
                                <TranslateTransform X="40" Y="8"/>
                            </Line.RenderTransform>
                        </Line>
                        <Line X1="0" Y1="0" X2="64" Y2="0" Stroke="#ECF0F1" StrokeThickness="3">
                            <Line.RenderTransform>
                                <TranslateTransform X="8" Y="40"/>
                            </Line.RenderTransform>
                        </Line>
                        <Line X1="0" Y1="0" X2="46" Y2="46" Stroke="#BDC3C7" StrokeThickness="3">
                            <Line.RenderTransform>
                                <TranslateTransform X="17" Y="17"/>
                            </Line.RenderTransform>
                        </Line>
                        <Line X1="0" Y1="46" X2="46" Y2="0" Stroke="#BDC3C7" StrokeThickness="3">
                            <Line.RenderTransform>
                                <TranslateTransform X="17" Y="17"/>
                            </Line.RenderTransform>
                        </Line>

                        <!-- MANIVELA DA RODA (CRANK): NASCE NO CENTRO EXATO (40,40) -->
                        <!-- Cubo da manivela no centro exato do eixo (40,40) -->
                        <Ellipse Width="24" Height="24" Fill="#5D6D7E" Stroke="#2C3E50" StrokeThickness="2">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="28" Y="28"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Braco solido de aco da manivela ligando o centro (40,40) ao pino (62,40) -->
                        <Rectangle Width="26" Height="12" Fill="#85929E" Stroke="#2C3E50" StrokeThickness="1.5" RadiusX="4" RadiusY="4">
                            <Rectangle.RenderTransform>
                                <TranslateTransform X="38" Y="34"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- Cabeca do pino da manivela em (62,40) -->
                        <Ellipse Width="16" Height="16" Fill="#5D6D7E" Stroke="#2C3E50" StrokeThickness="1.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="54" Y="32"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Pino excentrico de manivela vermelho em (62,40) raio r=22px -->
                        <Ellipse Width="8" Height="8" Fill="#C0392B" Stroke="#78281F" StrokeThickness="1">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="58" Y="36"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Parafuso do eixo no centro matematico absoluto da roda (40,40) -->
                        <Ellipse Width="8" Height="8" Fill="#111111">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="36" Y="36"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </ControlTemplate>
            </Canvas.Resources>

            <!-- # ===================================================================== -->
            <!-- # CENÁRIO: TRILHOS DE AÇO E LASTRO DE BRITA                              -->
            <!-- # ===================================================================== -->
            <Canvas Width="1060" Height="40">
                <Canvas.RenderTransform>
                    <TranslateTransform X="0" Y="405"/>
                </Canvas.RenderTransform>
                <!-- Lastro de brita -->
                <Rectangle Width="1060" Height="30" Fill="#283747"/>
                <!-- Trilho Superior de Aco Cromado -->
                <Rectangle Width="1060" Height="6" Fill="#BDC3C7" Stroke="#7F8C8D" StrokeThickness="1">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- Base do Trilho -->
                <Rectangle Width="1060" Height="10" Fill="#17202A">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="0" Y="6"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <!-- # ===================================================================== -->
            <!-- # CONJUNTO COMPLETO DA LOCOMOTIVA (CANVAS TRANSLADÁVEL)                 -->
            <!-- # ===================================================================== -->
            <!-- * Trabalho C1.md:42 e Slide 2D.md:237-251: Objeto agrupado em Canvas    -->
            <!-- ! INVARIANTE: Todos os elementos internos são desenhados a partir de    -->
            <!-- ! (0,0) e posicionados unicamente com RenderTransform (Translate/Rotate)-->
            <Canvas x:Name="LocomotivaCanvas" Width="560" Height="300">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="TranslacaoLocomotiva" X="-100" Y="155"/>
                </Canvas.RenderTransform>

                <!-- * Feixe de luz volumétrico do farol dianteiro -->
                <Polygon Points="0,15 240,-35 240,65" Fill="#18FFF59D">
                    <Polygon.RenderTransform>
                        <TranslateTransform X="475" Y="100"/>
                    </Polygon.RenderTransform>
                </Polygon>

                <!-- * Partículas volumétricas de vapor saindo da chaminé -->
                <Ellipse x:Name="Fumaca1" Width="20" Height="20" Fill="#65FFFFFF">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="EscalaFumaca1" ScaleX="1" ScaleY="1" CenterX="10" CenterY="10"/>
                            <TranslateTransform x:Name="TranslacaoFumaca1" X="395" Y="20"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Fumaca2" Width="26" Height="26" Fill="#55E0E0E0">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="EscalaFumaca2" ScaleX="1" ScaleY="1" CenterX="13" CenterY="13"/>
                            <TranslateTransform x:Name="TranslacaoFumaca2" X="380" Y="0"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Fumaca3" Width="34" Height="34" Fill="#38D0D0D0">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="EscalaFumaca3" ScaleX="1" ScaleY="1" CenterX="17" CenterY="17"/>
                            <TranslateTransform x:Name="TranslacaoFumaca3" X="355" Y="-25"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- # ================================================================= -->
                <!-- # CORPO DA LOCOMOTIVA: PRIMITIVAS EM (0,0) COM RENDERTRANSFORM     -->
                <!-- # ================================================================= -->

                <!-- # SEÇÃO 1: CHASSI E ESTRUTURA INFERIOR RÍGIDA -->
                <Rectangle Width="500" Height="18" Fill="#1C2833" Stroke="#0E161C" StrokeThickness="2" RadiusX="3" RadiusY="3">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="15" Y="190"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- * Para-choque traseiro (Buffer Beam & Buffer) -->
                <Rectangle Width="10" Height="22" Fill="#C0392B" Stroke="#78281F" StrokeThickness="1.5">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="8" Y="188"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse Width="10" Height="14" Fill="#7F8C8D" Stroke="#2C3E50" StrokeThickness="1.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="2" Y="192"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- # SEÇÃO 2: PARA-CHOQUES, ENGATE E LIMPA-TRILHOS DIANTEIRO -->
                <!-- * Viga transversal de sustentação do para-choque dianteiro (Buffer Beam) -->
                <Rectangle Width="12" Height="24" Fill="#C0392B" Stroke="#78281F" StrokeThickness="1.5">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="496" Y="187"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- * Prato circular e haste amortecedora do para-choque -->
                <Rectangle Width="8" Height="6" Fill="#7F8C8D">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="508" Y="196"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse Width="8" Height="16" Fill="#BDC3C7" Stroke="#2C3E50" StrokeThickness="1.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="514" Y="191"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- * Engate Ferroviário: Gancho forjado e elo de corrente -->
                <Polygon Points="0,3 12,0 12,12 0,9" Fill="#2C3E50" Stroke="#17202A" StrokeThickness="1">
                    <Polygon.RenderTransform>
                        <TranslateTransform X="506" Y="203"/>
                    </Polygon.RenderTransform>
                </Polygon>
                <Ellipse Width="8" Height="12" Fill="Transparent" Stroke="#7F8C8D" StrokeThickness="2">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="514" Y="204"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- * Limpa-Trilhos em Cunha (Cowcatcher / Pilot com grades protetoras) -->
                <!-- ? Geometria calculada: parte da base da viga (Y=208) até o topo do trilho (Y=246) sem colidir com cilindro -->
                <Polygon Points="0,0 26,38 0,38" Fill="#C0392B" Stroke="#78281F" StrokeThickness="2">
                    <Polygon.RenderTransform>
                        <TranslateTransform X="496" Y="208"/>
                    </Polygon.RenderTransform>
                </Polygon>
                <!-- * Grades internas de proteção do limpa-trilhos -->
                <Line X1="0" Y1="0" X2="18" Y2="26" Stroke="#F4D03F" StrokeThickness="2">
                    <Line.RenderTransform>
                        <TranslateTransform X="500" Y="216"/>
                    </Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="0" X2="9" Y2="20" Stroke="#F4D03F" StrokeThickness="2">
                    <Line.RenderTransform>
                        <TranslateTransform X="498" Y="224"/>
                    </Line.RenderTransform>
                </Line>

                <!-- # SEÇÃO 3: DEPÓSITO TRASEIRO DE CARVÃO (BUNKER DA LOCOMOTIVA-TANQUE) -->
                <Rectangle Width="35" Height="100" Fill="#1F618D" Stroke="#154360" StrokeThickness="2" RadiusX="2" RadiusY="2">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="20" Y="95"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- * Carga de carvão mineral no topo do bunker -->
                <Polygon Points="0,15 10,0 25,2 35,15" Fill="#17202A">
                    <Polygon.RenderTransform>
                        <TranslateTransform X="20" Y="82"/>
                    </Polygon.RenderTransform>
                </Polygon>
                <!-- * Lanterna de cauda com luz de sinalização vermelha -->
                <Ellipse Width="10" Height="12" Fill="#E74C3C" Stroke="#922B21" StrokeThickness="1.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="12" Y="110"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- # SEÇÃO 4: CABINE DO MAQUINISTA COM ACESSO, ESTRIBOS E JANELA -->
                <Rectangle Width="120" Height="135" Fill="#21618C" Stroke="#154360" StrokeThickness="2" RadiusX="3" RadiusY="3">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="55" Y="65"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- * Teto aerodinâmico da cabine com beiral pronunciado -->
                <Polygon Points="0,14 10,0 142,0 137,14" Fill="#1A5276" Stroke="#113349" StrokeThickness="2">
                    <Polygon.RenderTransform>
                        <TranslateTransform X="45" Y="52"/>
                    </Polygon.RenderTransform>
                </Polygon>

                <!-- * Porta de acesso com maçaneta de bronze e corrimão de latão -->
                <Rectangle Width="36" Height="95" Fill="#1B4F72" Stroke="#154360" StrokeThickness="1.5" RadiusX="3" RadiusY="3">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="62" Y="95"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse Width="6" Height="6" Fill="#F1C40F" Stroke="#B7950B" StrokeThickness="1">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="90" Y="145"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Line X1="0" Y1="0" X2="0" Y2="85" Stroke="#F39C12" StrokeThickness="2.5">
                    <Line.RenderTransform>
                        <TranslateTransform X="60" Y="102"/>
                    </Line.RenderTransform>
                </Line>

                <!-- * Estribos / Escada metálica de subida do maquinista -->
                <Rectangle Width="28" Height="4" Fill="#7F8C8D" Stroke="#2C3E50" StrokeThickness="1">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="66" Y="198"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="28" Height="4" Fill="#7F8C8D" Stroke="#2C3E50" StrokeThickness="1">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="66" Y="208"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Line X1="0" Y1="0" X2="0" Y2="20" Stroke="#2C3E50" StrokeThickness="2">
                    <Line.RenderTransform>
                        <TranslateTransform X="66" Y="192"/>
                    </Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="0" X2="0" Y2="20" Stroke="#2C3E50" StrokeThickness="2">
                    <Line.RenderTransform>
                        <TranslateTransform X="94" Y="192"/>
                    </Line.RenderTransform>
                </Line>

                <!-- * Janela panorâmica da cabine com divisória -->
                <Rectangle Width="42" Height="40" Fill="#A9CCE3" Stroke="#1B4F72" StrokeThickness="2.5" RadiusX="4" RadiusY="4">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="112" Y="88"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Line X1="21" Y1="0" X2="21" Y2="40" Stroke="#1B4F72" StrokeThickness="2">
                    <Line.RenderTransform>
                        <TranslateTransform X="112" Y="88"/>
                    </Line.RenderTransform>
                </Line>

                <!-- # SEÇÃO 5: CALDEIRA CILÍNDRICA E CINTAS DE BRONZE -->
                <Rectangle Width="235" Height="65" Fill="#2874A6" Stroke="#1B4F72" StrokeThickness="2" RadiusX="3" RadiusY="3">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="175" Y="95"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- * Cintas metálicas de reforço estrutural da caldeira -->
                <Rectangle Width="6" Height="65" Fill="#F39C12">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="235" Y="95"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="6" Height="65" Fill="#F39C12">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="300" Y="95"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- # SEÇÃO 6: TANQUE LATERAL DE ÁGUA (SIDE TANK - MODELO 0-4-0T) -->
                <!-- ? Permite autonomia de vapor eliminando a necessidade de vagão tender separado -->
                <Rectangle Width="185" Height="60" Fill="#1F618D" Stroke="#154360" StrokeThickness="2" RadiusX="4" RadiusY="4">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="175" Y="135"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="185" Height="8" Fill="#1A5276">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="175" Y="145"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- * Bocal superior de abastecimento de água com tampa de latão -->
                <Rectangle Width="16" Height="10" Fill="#F39C12" Stroke="#B7950B" StrokeThickness="1" RadiusX="2" RadiusY="2">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="255" Y="126"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse Width="18" Height="6" Fill="#D68910">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="254" Y="124"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- # SEÇÃO 7: DOMO DE VAPOR, SINO, CÂMARA DE FUMAÇA E FAROL -->
                <!-- * Domo coletor de vapor pressurizado -->
                <Ellipse Width="42" Height="34" Fill="#D35400" Stroke="#935116" StrokeThickness="2">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="220" Y="70"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Rectangle Width="46" Height="12" Fill="#A04000">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="218" Y="90"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- * Sino de latão e suporte -->
                <Polygon Points="6,0 18,0 22,16 2,16" Fill="#F1C40F" Stroke="#B7950B" StrokeThickness="1">
                    <Polygon.RenderTransform>
                        <TranslateTransform X="295" Y="80"/>
                    </Polygon.RenderTransform>
                </Polygon>
                <Rectangle Width="6" Height="6" Fill="#7F8C8D">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="304" Y="92"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- * Chaminé cônica e câmara de fumaça -->
                <Ellipse Width="38" Height="85" Fill="#1B4F72" Stroke="#154360" StrokeThickness="2">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="392" Y="105"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Polygon Points="4,0 44,0 36,60 12,60" Fill="#17202A" Stroke="#0E161C" StrokeThickness="2">
                    <Polygon.RenderTransform>
                        <TranslateTransform X="383" Y="46"/>
                    </Polygon.RenderTransform>
                </Polygon>
                <Ellipse Width="46" Height="10" Fill="#C0392B" Stroke="#78281F" StrokeThickness="1.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="382" Y="42"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- * Farol de proa dianteiro com lente refletora -->
                <Polygon Points="0,6 28,0 28,34 0,28" Fill="#F39C12" Stroke="#B7950B" StrokeThickness="2">
                    <Polygon.RenderTransform>
                        <TranslateTransform X="428" Y="102"/>
                    </Polygon.RenderTransform>
                </Polygon>
                <Ellipse Width="8" Height="26" Fill="#FFFF99" Stroke="#F1C40F" StrokeThickness="1">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="452" Y="106"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- # SEÇÃO 8: BLOCO DO CILINDRO DE VAPOR E GUIAS DA CRUZETA -->
                <!-- * Suporte vertical estrutural (Motion Bracket / Guide Yoke) ligando as guias ao chassi -->
                <Rectangle Width="8" Height="32" Fill="#1C2833" Stroke="#0E161C" StrokeThickness="1">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="314" Y="192"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- * Base de fixação rígida do bloco de cilindro ao chassi -->
                <Rectangle Width="82" Height="10" Fill="#17202A" Stroke="#0E161C" StrokeThickness="1">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="390" Y="186"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- * Corpo cilíndrico de alta pressão centrado rigorosamente no eixo Y=210 -->
                <Rectangle Width="75" Height="36" Fill="#2C3E50" Stroke="#1A252F" StrokeThickness="2" RadiusX="3" RadiusY="3">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="390" Y="192"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- * Cabeçote frontal do cilindro -->
                <Ellipse Width="14" Height="36" Fill="#34495E" Stroke="#1A252F" StrokeThickness="2">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="457" Y="192"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <!-- * Gaxeta de vedação traseira por onde a haste do pistão entra no cilindro -->
                <Rectangle Width="6" Height="26" Fill="#1A252F" Stroke="#0E161C" StrokeThickness="1">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="386" Y="197"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- * Guias horizontais cromadas (Slide bars) para deslizamento suave da cruzeta em Y=210 -->
                <Line X1="0" Y1="0" X2="72" Y2="0" Stroke="#BDC3C7" StrokeThickness="3.5">
                    <Line.RenderTransform>
                        <TranslateTransform X="318" Y="200"/>
                    </Line.RenderTransform>
                </Line>
                <Line X1="0" Y1="0" X2="72" Y2="0" Stroke="#BDC3C7" StrokeThickness="3.5">
                    <Line.RenderTransform>
                        <TranslateTransform X="318" Y="220"/>
                    </Line.RenderTransform>
                </Line>

                <!-- # ===================================================================== -->
                <!-- # INSTÂNCIAS DAS RODAS SOB O CHASSI (ControlTemplate + RotateTransform) -->
                <!-- # ===================================================================== -->
                <!-- * Requisito Trabalho C1.md:36 e Slide 2D.md:270: Pelo menos 2 instâncias -->
                <!-- * compartilhando o mesmo ControlTemplate com rotação contínua           -->

                <!-- * Roda 1 (Traseira): Centro analítico em (130, 210) -->
                <Control Template="{StaticResource RodaTemplate}" Width="80" Height="80">
                    <Control.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="RotacaoRoda1" Angle="0" CenterX="40" CenterY="40"/>
                            <TranslateTransform X="90" Y="170"/>
                        </TransformGroup>
                    </Control.RenderTransform>
                </Control>

                <!-- * Roda 2 (Dianteira): Centro analítico em (270, 210) -->
                <Control Template="{StaticResource RodaTemplate}" Width="80" Height="80">
                    <Control.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="RotacaoRoda2" Angle="0" CenterX="40" CenterY="40"/>
                            <TranslateTransform X="230" Y="170"/>
                        </TransformGroup>
                    </Control.RenderTransform>
                </Control>

                <!-- # ===================================================================== -->
                <!-- # SISTEMA DE BIELAS COM CINEMÁTICA ANALÍTICA POR QUADRO                 -->
                <!-- # ===================================================================== -->
                <!-- * Conforme Trabalho C1.md:48-52 (Etapa 3 - 8,0 pontos)                  -->
                <!-- * Sincronização matemática analítica exata sem defasagem temporal       -->

                <!-- # BIELA A: BARRA DE ACOPLAMENTO HORIZONTAL (SIDE ROD) -->
                <!-- * Liga perfeitamente os pinos de manivela da Roda 1 e da Roda 2         -->
                <!-- * Olhal 1 em (0,0) encaixa no pino da Roda 1                           -->
                <!-- * Olhal 2 em (140,0) encaixa no pino da Roda 2                          -->
                <!-- ? Transladada a cada quadro para a posição de órbita do pino 1!        -->
                <Canvas x:Name="BielaAcoplamentoCanvas" Width="160" Height="20">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="TranslacaoBielaAcoplamento" X="152" Y="210"/>
                    </Canvas.RenderTransform>

                    <!-- * Corpo de aço usinado com perfil I-Beam (distância 140px entre eixos) -->
                    <Rectangle Width="150" Height="8" RadiusX="3" RadiusY="3" Fill="#BDC3C7" Stroke="#566573" StrokeThickness="1.5">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-5" Y="-4"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- * Canaleta central rebaixada de alívio de peso -->
                    <Rectangle Width="124" Height="3" Fill="#2C3E50">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="8" Y="-1.5"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- * Copos de lubrificação de latão no topo dos mancais -->
                    <Rectangle Width="4" Height="4" Fill="#F39C12" Stroke="#B7950B" StrokeThickness="0.8">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-2" Y="-13"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="4" Height="4" Fill="#F39C12" Stroke="#B7950B" StrokeThickness="0.8">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="138" Y="-13"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- * Mancal/Olhal Traseiro encaixado perfeitamente no pino da Roda 1 em (0,0) -->
                    <Ellipse Width="18" Height="18" Fill="#D4AC0D" Stroke="#7D6608" StrokeThickness="1.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-9" Y="-9"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="10" Height="10" Fill="#7F8C8D" Stroke="#2C3E50" StrokeThickness="1">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-5" Y="-5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="#C0392B">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-3" Y="-3"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- * Mancal/Olhal Dianteiro encaixado perfeitamente no pino da Roda 2 em (140,0) -->
                    <Ellipse Width="18" Height="18" Fill="#D4AC0D" Stroke="#7D6608" StrokeThickness="1.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="131" Y="-9"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="10" Height="10" Fill="#7F8C8D" Stroke="#2C3E50" StrokeThickness="1">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="135" Y="-5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="#C0392B">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="137" Y="-3"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <!-- # BIELA B: CRUZETA DESLIZANTE (CROSSHEAD) E HASTE DO PISTÃO -->
                <!-- * Desliza estritamente no eixo horizontal Y = 210 entre as guias de aço -->
                <!-- * Haste cilíndrica de aço cromado adentrando o cilindro de vapor -->
                <Rectangle Width="50" Height="6" Fill="#ECF0F1" Stroke="#7F8C8D" StrokeThickness="1">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="TranslacaoHastePistao" X="370" Y="207"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- * Cruzeta deslizante (sapata guia de aço) -->
                <Rectangle Width="18" Height="18" Fill="#7F8C8D" Stroke="#2C3E50" StrokeThickness="1.5" RadiusX="3" RadiusY="3">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="TranslacaoCruzeta" X="356" Y="201"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- * Pino articulador de bronze da cruzeta centrado em (0,0) local -->
                <Ellipse Width="8" Height="8" Fill="#F1C40F" Stroke="#B7950B" StrokeThickness="1">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="TranslacaoPinoCruzeta" X="361" Y="206"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- # BIELA C: BIELA MOTRIZ ARTICULADA (CONNECTING ROD) -->
                <!-- * Haste principal de transferência mecânica de força entre pistão e Roda 2 -->
                <!-- * Olhal traseiro em (0,0) coincide exatamente com o pino da Roda 2       -->
                <!-- * Olhal dianteiro em (95,0) coincide rigorosamente com o pino da cruzeta  -->
                <!-- ! O ângulo de rotação é calculado a cada quadro com Math.Atan2 sem inversão! -->
                <Canvas x:Name="BielaMotrizCanvas" Width="105" Height="16">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="RotacaoBielaMotriz" Angle="0" CenterX="0" CenterY="0"/>
                            <TranslateTransform x:Name="TranslacaoBielaMotriz" X="292" Y="210"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- * Braço da Biela Motriz de comprimento L=95px em aço usinado -->
                    <Rectangle Width="95" Height="7" RadiusX="3" RadiusY="3" Fill="#BDC3C7" Stroke="#566573" StrokeThickness="1.5">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="0" Y="-3.5"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- * Canaleta interna rebaixada -->
                    <Rectangle Width="72" Height="2.5" Fill="#2C3E50">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="12" Y="-1.25"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- * Copo de lubrificação de latão na cabeça da biela -->
                    <Rectangle Width="4" Height="4" Fill="#F39C12" Stroke="#B7950B" StrokeThickness="0.8">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-2" Y="-13"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- * Olhal traseiro conectado perfeitamente ao pino da Roda 2 em (0,0) -->
                    <Ellipse Width="18" Height="18" Fill="#D4AC0D" Stroke="#7D6608" StrokeThickness="1.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-9" Y="-9"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="10" Height="10" Fill="#7F8C8D" Stroke="#2C3E50" StrokeThickness="1">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-5" Y="-5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="#C0392B">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-3" Y="-3"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- * Olhal dianteiro conectado perfeitamente ao pino da cruzeta em (95,0) -->
                    <Ellipse Width="14" Height="14" Fill="#D4AC0D" Stroke="#7D6608" StrokeThickness="1.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="88" Y="-7"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="#F1C40F" Stroke="#B7950B" StrokeThickness="1">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="92" Y="-3"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

            </Canvas>

            <!-- # ===================================================================== -->
            <!-- # ANIMAÇÃO DECLARATIVA: FUMAÇA DA CHAMINÉ VIA STORYBOARD (DoubleAnimation)-->
            <!-- # ===================================================================== -->
            <Canvas.Triggers>
                <EventTrigger RoutedEvent="Canvas.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <!-- * Baforada 1 -->
                            <DoubleAnimation Storyboard.TargetName="TranslacaoFumaca1" Storyboard.TargetProperty="Y"
                                             From="40" To="-40" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="TranslacaoFumaca1" Storyboard.TargetProperty="X"
                                             From="395" To="320" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="EscalaFumaca1" Storyboard.TargetProperty="ScaleX"
                                             From="0.5" To="2.2" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="EscalaFumaca1" Storyboard.TargetProperty="ScaleY"
                                             From="0.5" To="2.2" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="Fumaca1" Storyboard.TargetProperty="Opacity"
                                             From="0.8" To="0.0" Duration="0:0:1.5" RepeatBehavior="Forever"/>

                            <!-- * Baforada 2 (com defasagem temporal de 0.5s) -->
                            <DoubleAnimation Storyboard.TargetName="TranslacaoFumaca2" Storyboard.TargetProperty="Y"
                                             BeginTime="0:0:0.5" From="40" To="-50" Duration="0:0:1.8" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="TranslacaoFumaca2" Storyboard.TargetProperty="X"
                                             BeginTime="0:0:0.5" From="395" To="290" Duration="0:0:1.8" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="EscalaFumaca2" Storyboard.TargetProperty="ScaleX"
                                             BeginTime="0:0:0.5" From="0.6" To="2.8" Duration="0:0:1.8" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="EscalaFumaca2" Storyboard.TargetProperty="ScaleY"
                                             BeginTime="0:0:0.5" From="0.6" To="2.8" Duration="0:0:1.8" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="Fumaca2" Storyboard.TargetProperty="Opacity"
                                             BeginTime="0:0:0.5" From="0.7" To="0.0" Duration="0:0:1.8" RepeatBehavior="Forever"/>

                            <!-- * Baforada 3 (com defasagem temporal de 1.0s) -->
                            <DoubleAnimation Storyboard.TargetName="TranslacaoFumaca3" Storyboard.TargetProperty="Y"
                                             BeginTime="0:0:1.0" From="40" To="-60" Duration="0:0:2.0" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="TranslacaoFumaca3" Storyboard.TargetProperty="X"
                                             BeginTime="0:0:1.0" From="395" To="260" Duration="0:0:2.0" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="EscalaFumaca3" Storyboard.TargetProperty="ScaleX"
                                             BeginTime="0:0:1.0" From="0.7" To="3.5" Duration="0:0:2.0" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="EscalaFumaca3" Storyboard.TargetProperty="ScaleY"
                                             BeginTime="0:0:1.0" From="0.7" To="3.5" Duration="0:0:2.0" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetName="Fumaca3" Storyboard.TargetProperty="Opacity"
                                             BeginTime="0:0:1.0" From="0.6" To="0.0" Duration="0:0:2.0" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Canvas.Triggers>
        </Canvas>

        <!-- # BARRA INFERIOR DE STATUS COM INSTRUÇÕES -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="40" Background="#11171E" BorderBrush="#2C3E50" BorderThickness="0,1,0,0">
            <Grid Margin="20,0,20,0">
                <TextBlock Text="WPF 2D • Cinemática Mecânica Analítica • Biela Motriz &amp; Acoplamento • 100% Sincronizado" Foreground="#7F8C8D" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="Trabalho 1 concluído com encaixe analítico perfeito (10,0)" Foreground="#2ECC71" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
